# =============================================================================
# Command Centre — single repo-root `.env` (see README). Do not commit filled copy.
# =============================================================================

# --- API identity (no login; backend resolves one DB user) ---
# Optional: pin which User.id the API uses for every request (recommended in production).
# SYSTEM_ACTOR_USER_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional: WebSocket ?user_id=… without calling /users/me first (must match a real User.id).
# NEXT_PUBLIC_SYSTEM_USER_ID=
# Docker Compose: backend defaults to redis://redis:6379/0 (see docker-compose.yml).
# Host dev without Redis: leave unset to use in-memory rate limits (per process only).
REDIS_URL=

# Docker: INTERNAL_API_URL=http://backend:8000/api/v1. Host app port (Compose): FRONTEND_HOST_PORT=3001

# --- Backend / database ---
PROJECT_NAME=
ENVIRONMENT=
API_V1_STR=

# Database: Compose uses pgvector/pgvector:pg15 (matches default volume major; pg16 needs new volume or dump/restore).
# Upgrading from plain Postgres may require:
#   docker compose down -v   (wipes local data) then up again.
# Docker Compose pins postgres / postgres_password / master_foundation for database + backend (see compose file).
# Use the same values here for Alembic or Uvicorn on the host (POSTGRES_SERVER=localhost, POSTGRES_PORT=5433).
# If auth still fails against an old volume, run: docker compose down -v (wipes DB) then up again.
POSTGRES_SERVER=database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=master_foundation
POSTGRES_PORT=5432

# API process: avoid "too many clients" — default Gunicorn workers are capped; Compose sets WEB_CONCURRENCY=2
# WEB_CONCURRENCY=2
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

GEMINI_API_KEY=
# Voice-only interview: Gemini native TTS (optional overrides)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# Optional: higher-reasoning model for nightly policy synthesis (default: gemini-2.5-pro)
# GEMINI_TEACHER_MODEL=gemini-2.5-pro

# HeyGen LiveAvatar (optional; mock interview room mints token via POST /interviews/liveavatar-token)
# LIVEAVATAR_API_KEY=
# LIVEAVATAR_AVATAR_ID=
# LIVEAVATAR_USE_SANDBOX=true
# LITE = only avatar_id required; FULL sends avatar_persona (see https://docs.liveavatar.com )
# LIVEAVATAR_SESSION_MODE=FULL
# LIVEAVATAR_LANGUAGE=en
# LIVEAVATAR_CONTEXT_ID=
# LIVEAVATAR_VOICE_ID=

# Comma-separated CORS origins (optional; sensible localhost defaults in code)
BACKEND_CORS_ORIGINS=

# --- Real-time bus (Phase 16): worker -> API internal push (must match between processes) ---
# Host dev (uvicorn + worker on machine): defaults in code to http://127.0.0.1:8000
# REALTIME_PUSH_BASE_URL=http://127.0.0.1:8000
# INTERNAL_REALTIME_SECRET=dev-internal-realtime-secret-change-in-production

# --- File storage (Phase 12) ---
# STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=data/uploads
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=
